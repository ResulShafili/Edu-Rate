# Lokal MVP autentifikasiyası üçün. Production-da ən azı 32 simvol uzunluğunda unikaldır.
EDURATE_AUTH_SECRET=minimum-32-simvolluq-unikal-production-sirriniz

# Xarici Express backend ünvanı. Boş olduqda EduRate Render API istifadə edilir.
# Brauzer sorğuları təhlükəsiz BFF üçün həmişə lokal /api altından keçir.
NEXT_PUBLIC_API_BASE_URL=
EDURATE_API_BASE_URL=

# Admin panelinə daxil ola biləcək e-poçtlar (vergüllə ayrılır).
# Eyni ünvanları Render-də ADMIN_EMAILS kimi də təyin edin.
EDURATE_ADMIN_EMAILS=

# Xarici Express backend-in HttpOnly sessiya cookie adı (istəyə bağlı).
EDURATE_SESSION_COOKIE_NAME=edurate_session
