# Node.js + Express REST API ünvanı. Sonundakı / işarəsi vacib deyil.
NEXT_PUBLIC_API_BASE_URL=https://api.example.edu.az/api/v1

# Sessiya yoxlaması üçün yalnız serverdə istifadə olunan API override-ı.
EDURATE_API_BASE_URL=https://api.example.edu.az/api/v1

# Express-in yaratdığı HttpOnly sessiya cookie-sinin adı.
EDURATE_SESSION_COOKIE_NAME=edurate_session
