NODE_ENV=development
PORT=3001

# Production-da Render PostgreSQL bu dəyəri təmin edir.
DATABASE_URL=

# Production üçün ən az 32 simvolluq təsadüfi dəyər yazın.
JWT_SECRET=minimum-32-simvolluq-unikal-production-sirri
JWT_EXPIRES_IN=30d

# Birdən çox ünvanı vergüllə ayırmaq mümkündür.
FRONTEND_URL=http://localhost:3000,https://edu-rate-nu.vercel.app

# Əsas admin rolu veriləcək e-poçtlar (vergüllə ayrılır).
# Admin köməkçisini bu hesablardan biri Admin panelində `assistant_admin` rolu ilə təyin edir.

# Render proxy arxasında işlədiyi üçün production-da true olmalıdır.
TRUST_PROXY=false
SEED_DEMO_DATA=false

# E-poçt təsdiqi və şifrə bərpası. Açar yoxdursa lokal mühitdə hesab dərhal təsdiqlənir.
RESEND_API_KEY=
EMAIL_FROM=EduRate <onboarding@resend.dev>
PUBLIC_APP_URL=http://localhost:3000

# Production API sənədlərini yalnız admin üçün qorumaq tövsiyə olunur.
SWAGGER_PUBLIC=false

# Təhlükəsiz şəkil yaddaşı. Preset signed olmalı, yalnız JPG/PNG/WebP qəbul
# etməli və maksimum fayl ölçüsü 5 MB olmalıdır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=edurate-secure
